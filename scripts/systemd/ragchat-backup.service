# Daily knowledge-base backup (docs/deploy.md). Installed by:
#   sudo cp scripts/systemd/ragchat-backup.* /etc/systemd/system/
# Edit User= and the paths if the checkout is not /opt/ragchat or the deploy
# user is not `ragchat`.
[Unit]
Description=RAGchat daily database backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=ragchat
WorkingDirectory=/opt/ragchat
ExecStart=/opt/ragchat/scripts/backup.sh
