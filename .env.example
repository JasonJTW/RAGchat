# Copy to `.env` in the repo root (`npm run setup:worktree` does it for you) and fill in.
# The server reads this file on `npm run dev` and `npm start`.

AI_GATEWAY_API_KEY=
# Model ids are `<provider>/<model>`, served by AI Gateway's OpenAI-compatible endpoint.
CHAT_MODEL=openai/gpt-5-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: models for extraction and for guests; each defaults to CHAT_MODEL.
# EXTRACT_MODEL=
# GUEST_MODEL=
# Postgres (`npm run db:up`). Both optional: the defaults match docker-compose.yml.
# Set POSTGRES_PORT and the port in DATABASE_URL together.
# POSTGRES_PORT=5433
# DATABASE_URL=postgres://ragchat:ragchat@localhost:5433/ragchat
# Jev (TypeSafe): checks whether a first question names its subject. Optional.
JEV_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
