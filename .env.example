# Copy to `.env` in the repo root (`npm run setup:worktree` does it for you) and fill in.
# The server reads this file on `npm run dev` and `npm start`.

AI_GATEWAY_API_KEY=
# Model ids are `<provider>/<model>`, served by AI Gateway's OpenAI-compatible endpoint.
CHAT_MODEL=openai/gpt-5-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: the model for extraction; defaults to CHAT_MODEL.
# EXTRACT_MODEL=
# The cheap model every 訪客 request uses (answers, extraction, corrections); defaults to CHAT_MODEL.
GUEST_MODEL=openai/gpt-5-nano
# Messages plus uploaded files all 訪客 together may use per day (Asia/Taipei); then guest trials pause. Default 1000.
# GUEST_DAILY_CAP=1000
# Postgres (`npm run db:up`). Both optional: the defaults match docker-compose.yml.
# Set POSTGRES_PORT and the port in DATABASE_URL together.
# POSTGRES_PORT=5433
# DATABASE_URL=postgres://ragchat:ragchat@localhost:5433/ragchat
# Jev (TypeSafe): checks whether a first question names its subject. Optional.
JEV_API_KEY=

# Clerk (development instance, Google sign-in). Web and server read both keys.
# Without CLERK_SECRET_KEY nobody can sign in. Tests and E2E use STUB_AUTH=1
# (a cookie fakes sign-in) instead; it is ignored while CLERK_SECRET_KEY is set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Organization id of MegaWeaving: its members are 成員, every other signed-in user is a 訪客.
CLERK_MEMBER_ORG_ID=
# 32 random bytes, base64 (`openssl rand -base64 32`). AES-256-GCM key for the pseudonym table (ADR-0004).
# Only this key turns the pseudonyms in the knowledge base (〔人名3〕) back into real values: without
# it the pseudonym table, the DB and its dumps reveal none of them. Keep this file mode 600 on the
# host and a copy in the password manager, never next to the DB backups. Lose it and every real
# value is gone for good; never change it on a database that already has pseudonyms.
# Without it the team workspace refuses every input and question (fails closed).
PSEUDONYM_ENCRYPTION_KEY=
# Presidio Analyzer (`npm run presidio:up`, docker-compose.yml) finds personal data before anything
# reaches a model or the DB. Optional: the default matches docker-compose.yml. Set PRESIDIO_PORT and
# the port here together. While it is down, the team workspace refuses input and questions.
# PRESIDIO_PORT=5002
# PRESIDIO_URL=http://localhost:5002
# `local` finds values with our regex recognizers alone, no sidecar (tests and E2E use it); never in production.
# PII_ANALYZER=
# Cloudflare Turnstile: a 訪客 passes it to get their trial workspace, then once a day.
# Cloudflare's test keys work for local dev. Tests and E2E fake it with STUB_TURNSTILE=1 (never in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Production (docker-compose.prod.yml, docs/deploy.md) --------------------------------------
# Password of the production Postgres. Hex only (`openssl rand -hex 24`): it goes into a URL.
# POSTGRES_PASSWORD=
# Public origin of the site, e.g. https://wiki.example.com (CORS on the server; default http://localhost:3000).
# WEB_ORIGIN=
# Host port of the web container, bound to 127.0.0.1 only (checks on the host). Default 3000.
# WEB_PORT=3000
# Cloudflare Tunnel token (Zero Trust › Networks › Tunnels). With COMPOSE_PROFILES=tunnel,
# `docker compose -f docker-compose.prod.yml up` also starts cloudflared; leave both unset to run without it.
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel
# Daily backups (scripts/backup.sh). BACKUP_DIR: where dumps go, recommended on another disk, never
# the directory holding this file (the script refuses it). Dumps older than 14 days are deleted.
# BACKUP_DIR=/mnt/backup/ragchat
# Optional rclone remote (`rclone config`) each dump is also copied to, e.g. offsite:ragchat; skipped when unset.
# BACKUP_RCLONE_REMOTE=
# Optional: the Postgres container backup.sh dumps (default ragchat-prod-postgres-1).
# BACKUP_PG_CONTAINER=
# Read from the shell only, never from this file (tests, restores): BACKUP_PG_DATABASE (the database
# backup.sh dumps, default ragchat; the NEW one restore.sh creates, default ragchat_restored) and
# BACKUP_ENV_FILE (the .env backup.sh reads, default this one).
