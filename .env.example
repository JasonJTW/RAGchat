# Copy to `.env` in the repo root (`npm run setup:worktree` does it for you) and fill in.
# The server reads this file on `npm run dev` and `npm start`.

AI_GATEWAY_API_KEY=
# Model ids are `<provider>/<model>`, served by AI Gateway's OpenAI-compatible endpoint.
CHAT_MODEL=openai/gpt-5-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: models for extraction and for guests; each defaults to CHAT_MODEL.
# EXTRACT_MODEL=
# GUEST_MODEL=
# Postgres (`npm run db:up`). Both optional: the defaults match docker-compose.yml.
# Set POSTGRES_PORT and the port in DATABASE_URL together.
# POSTGRES_PORT=5433
# DATABASE_URL=postgres://ragchat:ragchat@localhost:5433/ragchat
# Jev (TypeSafe): checks whether a first question names its subject. Optional.
JEV_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Clerk (development instance, Google sign-in). Web reads the publishable key; server the secret key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Organization id of MegaWeaving: its members are 成員, every other signed-in user is a 訪客.
CLERK_MEMBER_ORG_ID=
# 32 random bytes, base64 (`openssl rand -base64 32`). AES-256-GCM key for the pseudonym table (ADR-0004).
# Keep a copy in the password manager, never next to the backups.
PSEUDONYM_ENCRYPTION_KEY=
# Cloudflare Turnstile for guest sign-up/messages. Cloudflare's test keys work for local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
